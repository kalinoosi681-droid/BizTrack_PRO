+"""
CLEAN DEVELOPMENT-ONLY INITIALIZATION
-------------------------------------
This ensures the following:
✔ app is ALWAYS defined before use
✔ CSRF protection initializes correctly
✔ development config always loads
✔ blueprint registration is stable
"""
+
+from flask import Flask
+from flask_wtf.csrf import CSRFProtect
+
+csrf = CSRFProtect()
+
+
+def create_app(config_name=None):
+    # 1) Create app FIRST
+    app = Flask(__name__)
+
+    # 2) Always load development config
+    try:
+        from biztrack.config import DevelopmentConfig
+        app.config.from_object(DevelopmentConfig)
+    except Exception:
+        # fallback
+        app.config.update(
+            SECRET_KEY="dev-secret-key",
+            WTF_CSRF_ENABLED=True,
+            SESSION_PERMANENT=False,
+            DEBUG=True,
+        )
+
+    # 3) Initialize CSRF AFTER app exists
+    csrf.init_app(app)
+
+    # 4) Register blueprints
+    try:
+        from .routes import main_bp
+        from .auth import auth_bp
+        app.register_blueprint(main_bp)
+        app.register_blueprint(auth_bp)
+    except Exception as e:
+        raise RuntimeError(f"Error registering blueprints: {e}")
+
+    return app
